# Server-only Vercel environment variables.
# Never put privileged values in browser JavaScript or commit real secrets.

# Mutating browser endpoints validate requests against the active deployment
# host. No deployment-specific ALLOWED_ORIGIN variable is required.

# Supabase project used by serverless functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# Optional HD deposit-address infrastructure. Public portfolio mode remains off.
ENABLE_REAL_DEPOSITS=false
HD_WALLET_XPUB=replace-only-in-private-deployment

# Optional admin Web Push alerts for demo review requests.
# Generate locally with: node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
VAPID_SUBJECT=mailto:admin@example.com
